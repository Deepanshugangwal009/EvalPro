FLASK_DEBUG=0
SECRET_KEY=replace_this_with_a_long_random_string

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=oes_db

# Set to 1 when the MySQL server is remote and requires TLS (Aiven, Clever Cloud, etc.)
MYSQL_SSL=0
# Optional path to the provider's CA certificate file. Leave empty to skip certificate verification.
MYSQL_SSL_CA=
MYSQL_POOL_SIZE=3

# Set to 1 when the site is served over HTTPS so the session cookie is marked secure.
SESSION_COOKIE_SECURE=0

PASS_PERCENTAGE=40

# Optional single connection string. When set it overrides the MYSQL_* values above.
# DATABASE_URL=mysql://user:password@host:3306/oes_db
